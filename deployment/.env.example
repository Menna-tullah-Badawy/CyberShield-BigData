# ==============================================================================
# CyberShield-BigData Environment Variables Template
# انسخ هذا الملف إلى .env وقم بتعبئة المتغيرات الخاصة ببيئتك
# ==============================================================================

# البيئة ومستوى التسجيل
ENVIRONMENT=production
LOG_LEVEL=INFO

# مسارات التشغيل (داخل الحاوية)
CYBERSHIELD_STORE=/app/data/feature_store/nids_features_latest
CYBERSHIELD_OUT=/app/benchmark_results

# بوت تليجرام للمراقبة الحية (اختياري - بدونه يعمل وضع المحاكاة)
CYBERSHIELD_BOT_TOKEN=your_telegram_bot_token_here
CYBERSHIELD_ADMIN_CHAT_ID=your_admin_chat_id_here
