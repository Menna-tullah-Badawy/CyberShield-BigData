# ==============================================================================
# CyberShield-BigData Environment Variables Template
# انسخ هذا الملف إلى .env وقم بتعبئة المتغيرات الخاصة ببيئتك
# ==============================================================================

# البيئة ومستوى التسجيل
ENVIRONMENT=production
LOG_LEVEL=INFO

# مفاتيح الذكاء الاصطناعي التوليدي (اختياري - في حال الغياب يعمل المحرك المحلي الحتمي)
OPENAI_API_KEY=your_openai_api_key_here
HF_HOME=/app/data/checkpoints/huggingface

# إعدادات الـ Spark Cluster في بيئة التشغيل
SPARK_MASTER_URL=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g